{
  "name": "@web3mcp/sdk",
  "version": "0.1.1",
  "description": "Node.js SDK for discovering and using Web3MCP tools from Solana programs",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-Managed/Web3MCP.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://www.web3mcp.org/docs/latest",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "files": ["dist", "schema", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./errors": { "types": "./dist/errors.d.ts", "import": "./dist/errors.js" }
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run test:types && node --test tests/*.test.js",
    "test:types": "tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 tests/consumer.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.99.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
