{
  "standard": "web3mcp",
  "version": "0.1.0",
  "programId": "11111111111111111111111111111111",
  "idl": {
    "address": "11111111111111111111111111111111",
    "metadata": {
      "name": "reference_vault",
      "version": "0.1.0",
      "spec": "0.1.0"
    },
    "instructions": [
      {
        "name": "deposit",
        "discriminator": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "accounts": [
          {
            "name": "vault",
            "writable": true,
            "pda": {
              "seeds": [
                {
                  "kind": "const",
                  "value": [
                    118,
                    97,
                    117,
                    108,
                    116
                  ]
                },
                {
                  "kind": "account",
                  "path": "user"
                }
              ]
            }
          },
          {
            "name": "user",
            "writable": true,
            "signer": true
          },
          {
            "name": "systemProgram",
            "address": "11111111111111111111111111111111"
          },
          {
            "name": "recipientAccount",
            "writable": true
          }
        ],
        "args": [
          {
            "name": "amount",
            "type": "u64"
          },
          {
            "name": "flag",
            "type": "bool"
          },
          {
            "name": "recipient",
            "type": "pubkey"
          }
        ]
      }
    ]
  },
  "tools": [
    {
      "name": "deposit",
      "title": "Deposit SOL into Vault",
      "description": "Transfers SOL from connected wallet into program vault",
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "Amount in lamports (u64 decimal string)"
          },
          "flag": {
            "type": "boolean",
            "description": "Optional behavior toggle"
          },
          "recipient": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
            "description": "Base58 public key recipient"
          }
        },
        "required": [
          "amount",
          "recipient",
          "flag"
        ],
        "additionalProperties": false
      },
      "solana": {
        "kind": "instruction",
        "instruction": "deposit",
        "accounts": {
          "vault": {
            "source": "idl"
          },
          "user": {
            "source": "signer"
          },
          "systemProgram": {
            "source": "program",
            "address": "11111111111111111111111111111111"
          },
          "recipientAccount": {
            "source": "input",
            "input": "recipient"
          }
        },
        "effects": {
          "stateChanging": true,
          "financial": true,
          "summary": "Deposits lamports from user to vault"
        }
      }
    }
  ]
