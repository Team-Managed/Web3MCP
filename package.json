{
  "name": "web3mcp",
  "version": "0.1.0",
  "description": "Web3MCP: on-chain Solana tool discovery for AI agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "packages/sdk",
    "apps/host"
  ],
  "scripts": {
    "test": "npm --prefix protocol test && npm --prefix packages/sdk run build && npm --prefix packages/sdk test && npm --prefix apps/host run build && npm --prefix apps/host test && node --test tests/generate-config.test.js tests/git-guardrails.test.js tests/publish-transaction.test.js",
    "test:sdk": "npm --prefix packages/sdk run build && npm --prefix packages/sdk test",
    "test:protocol": "npm --prefix protocol test",
    "test:host": "npm --prefix packages/sdk run build && npm --prefix apps/host run build && npm --prefix apps/host test",
    "test:integration": "npm --prefix packages/sdk run build && npm --prefix apps/host run build && node --test --test-concurrency=1 tests/*.test.js",
    "generate:config": "node reference-programs/reference-vault/scripts/generate-config.js",
    "publish:vault": "node reference-programs/reference-vault/scripts/publish.js",
    "host": "node apps/host/bin/web3mcp.js"
  },
